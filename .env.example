# Copie este arquivo para .env.local e preencha com os dados do SEU projeto Supabase
# (Painel do Supabase > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# Obrigatória para o upload de fotos e para /admin/configurar
# (Painel do Supabase > Project Settings > API > "service_role" — NUNCA no navegador)
SUPABASE_SERVICE_ROLE_KEY=

# --- Nomes alternativos, aceitos automaticamente ---
# A integração oficial Supabase<->Vercel escreve as variáveis com OUTROS nomes
# (o Supabase renomeou "anon" para publishable e "service_role" para secret).
# Se usar a integração, não precisa preencher nada acima — o código aceita os
# dois conjuntos. Ver lib/supabase/credenciais.ts
#
# SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# Opcional - só quando for configurar a IA (camada gratuita)
GROQ_API_KEY=

# Opcional - só quando for configurar o WhatsApp Cloud API (camada gratuita)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Módulo de aluguéis — notificações (opcional, funciona em modo "stub"/console sem isso)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
RESEND_API_KEY=
EMAIL_REMETENTE=financeiro@gmimoveis.com.br
